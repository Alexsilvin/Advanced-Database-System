# DATABASE_URL: PostgreSQL connection string (e.g., postgresql://user:password@host:port/dbname)
DATABASE_URL="MY_POSTGRES_URL"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin bootstrap account used to seed the first admin user.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME"

# Optional admin key required by /api/game-download-url when configured.
ROM_ADMIN_KEY="MY_ROM_ADMIN_KEY"

# If true, /api/game-download-url checks library_items ownership before issuing signed URLs.
DOWNLOAD_REQUIRE_LIBRARY="true"

# S3-compatible object storage config for ROM download URL signing (AWS S3, Cloudflare R2, etc).
S3_REGION="auto"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_BUCKET="retro-roms"
S3_ACCESS_KEY_ID="MY_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="MY_S3_SECRET_ACCESS_KEY"
S3_FORCE_PATH_STYLE="false"

# Filebase-specific notes:
# - Use the Filebase S3 endpoint here for upload/download signing.
# - The RPC endpoint is separate and is only needed for IPFS pinning workflows.
FILEBASE_BUCKET="sfc-rom"
FILEBASE_IPFS_RPC_ENDPOINT="https://rpc.filebase.io"

# Optional admin key required by /api/enrich-posters when configured.
POSTER_ENRICH_ADMIN_KEY="MY_POSTER_ENRICH_ADMIN_KEY"

# Poster lookup providers (set one or both):
RAWG_API_KEY="MY_RAWG_API_KEY"
IGDB_CLIENT_ID="MY_IGDB_CLIENT_ID"
IGDB_CLIENT_SECRET="MY_IGDB_CLIENT_SECRET"
